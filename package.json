{
  "name": "vitre-css",
  "version": "1.6.0",
  "description": "Class-free and style-free web with a high-end glass finish for semantic HTML, plus optional behavior helpers.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://docs.vitre-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitre-ui/vitre-css.git"
  },
  "bugs": {
    "url": "https://github.com/vitre-ui/vitre-css/issues"
  },
  "keywords": [
    "css",
    "classless",
    "class-free",
    "styleless",
    "style-free",
    "semantic-html",
    "stylesheet",
    "theme",
    "dark-mode",
    "vitre",
    "vitre-ui",
    "ui",
    "alerts"
  ],
  "main": "vitre.css",
  "style": "vitre.css",
  "unpkg": "vitre.css",
  "jsdelivr": "vitre.css",
  "exports": {
    ".": "./vitre.css",
    "./vitre.css": "./vitre.css",
    "./vitre-base.css": "./vitre-base.css",
    "./vitre.js": "./vitre.js",
    "./package.json": "./package.json"
  },
  "files": [
    "vitre-base.css",
    "vitre.css",
    "vitre.js",
    "README.md",
    "REFERENCE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check vitre.js && npm pack --dry-run",
    "release": "npm publish --access public"
  }
}
